# 复制为 deploy/.env 并填入真实值；该文件不进仓库。
# PUBLIC_BASE_URL 是 CSRF Origin 校验的基准值，必须与用户实际访问的地址逐字一致。
PUBLIC_BASE_URL=https://ledger.example.com

# 账单邮箱 JMAP 会话入口。self-host 环境强制使用 HTTPS。
BILL_INBOX_JMAP_SESSION_URL=https://mail.example.com/jmap/session
# 必须是专用独立邮箱账号，且与 ADDRESS 相同；当前不会在共享邮箱内按别名过滤。
BILL_INBOX_USERNAME=zhiyu-bills-unique@example.com
BILL_INBOX_ADDRESS=zhiyu-bills-unique@example.com
# 必须与知余中的登录邮箱逐字一致，其他用户不能访问该收件箱。
BILL_INBOX_OWNER_EMAIL=owner@example.com
# 宿主机上的纯密码文件；Compose 以只读 secret 挂载，不把密码写进环境变量。
BILL_INBOX_PASSWORD_FILE=/opt/zhiyu/secrets/bill-inbox-password
BILL_INBOX_POLL_INTERVAL_SECONDS=300
BILL_INBOX_MAX_MESSAGE_BYTES=10485760

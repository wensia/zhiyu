APP_ENV=development
BIND_ADDR=127.0.0.1:8790
PUBLIC_BASE_URL=http://127.0.0.1:5173
DATABASE_URL=file:./var/zhiyu.db
TURSO_AUTH_TOKEN=
DEV_MAIL_DIR=./var/dev-mail
WEB_DIST_DIR=./apps/web/dist
RUST_LOG=zhiyu_api=debug,tower_http=info

# Optional bill inbox. Leave the whole block unset to disable it; setting any
# value requires all five core values. The password file must contain only the
# mailbox password (a trailing newline is ignored).
# BILL_INBOX_JMAP_SESSION_URL=http://127.0.0.1:8081/jmap/session
# BILL_INBOX_USERNAME=zhiyu-bills-unique@example.com
# BILL_INBOX_PASSWORD_FILE=./var/secrets/bill-inbox-password
# BILL_INBOX_ADDRESS=zhiyu-bills-unique@example.com
# BILL_INBOX_OWNER_EMAIL=owner@example.com
# BILL_INBOX_POLL_INTERVAL_SECONDS=300
# BILL_INBOX_MAX_MESSAGE_BYTES=10485760

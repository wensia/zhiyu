{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "远程主窗口只允许从标题区域开始拖动窗口",
  "remote": {
    "urls": ["http://*", "http://127.0.0.1:5173", "https://*"]
  },
  "windows": ["main"],
  "permissions": ["core:window:allow-start-dragging", "allow-reset-main-window"]
}
